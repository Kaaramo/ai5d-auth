{
  "name": "@ai5d/auth",
  "version": "1.0.2",
  "description": "SDK d'identite de l'ecosysteme AI5D : session, organisation active et droits du visiteur, lus sur AI5D Compte",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./middleware": "./src/middleware.ts",
    "./react": "./src/react/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@ai5d/design-system": "*",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@ai5d/design-system": "github:Kaaramo/ai5d-digital-design-system#v0.7.0",
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.17.0",
    "jsdom": "^30.0.1",
    "next": "^16.2.12",
    "prettier": "^3.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
